# =============================================================================
# Terraform Variables for Cloudflare Configuration
# Copy to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.sample terraform.tfvars
# =============================================================================

# Cloudflare API token (create at https://dash.cloudflare.com/profile/api-tokens)
# Required permissions:
#   - Account > Cloudflare Tunnel > Edit
#   - Account > Access: Apps and Policies > Edit
#   - Zone > DNS > Edit
#   - Zone > Zone > Read
# Only when the matching switch below is on:
#   - Account > Turnstile > Edit    (enable_tolon_turnstile)
#   - Zone > Zone WAF > Edit        (enable_tolon_rate_limit)
cloudflare_api_token = "your-api-token-here"

# Found at: Cloudflare Dashboard > your domain > Overview > API (right sidebar)
cloudflare_account_id = "your-account-id-here"
cloudflare_zone_id    = "your-zone-id-here"

# Your domain name
domain = "example.com"

# Email address for Cloudflare Zero Trust OTP (all services, including the Tolon poll results paths)
admin_email = "your-email@example.com"

# Resend sending domain for the Tolon poll emails. Copy the records Resend shows
# for tolon.<your-domain> (use full record names). Leave empty until then.
# resend_dns_records = {
#   dkim = { name = "resend._domainkey.tolon.example.com", type = "TXT", content = "p=MIGfMA0..." }
#   spf  = { name = "send.tolon.example.com", type = "TXT", content = "v=spf1 include:amazonses.com ~all" }
#   mx   = { name = "send.tolon.example.com", type = "MX", content = "feedback-smtp.eu-west-1.amazonses.com", priority = 10 }
#   click = { name = "rsend.tolon.example.com", type = "CNAME", content = "<value shown by Resend>" }
#   dmarc = { name = "_dmarc.tolon.example.com", type = "TXT", content = "\"v=DMARC1; p=none;\"" }
# }

# Tolon poll Turnstile widget (default false). Needs the token permission above.
# enable_tolon_turnstile = true

# Tolon poll edge rate limit, 20 requests per 10 s per IP (default false). Needs the token permission above.
# enable_tolon_rate_limit = true
