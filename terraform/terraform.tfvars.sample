# =============================================================================
# Terraform Variables for Cloudflare Configuration
# Copy to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.sample terraform.tfvars
# =============================================================================

# Cloudflare API token (create at https://dash.cloudflare.com/profile/api-tokens)
# Required permissions:
#   - Account > Cloudflare Tunnel > Edit
#   - Account > Access: Apps and Policies > Edit
#   - Zone > DNS > Edit
#   - Zone > Zone > Read
# Only when the matching switch below is on (shown as in the token editor):
#   - Zone > Zone WAF > Edit                 (Zone WAF Write; enable_tolon_rate_limit)
#   - Zone > Email Routing Rules > Edit      (enable_tolon_contact)
#   - Account > Email Routing Addresses > Edit (enable_tolon_contact)
#   - Zone > Zone Settings > Edit            (Zone Settings Write; in use on the live token)
cloudflare_api_token = "your-api-token-here"

# Found at: Cloudflare Dashboard > your domain > Overview > API (right sidebar)
cloudflare_account_id = "your-account-id-here"
cloudflare_zone_id    = "your-zone-id-here"

# Your domain name
domain = "example.com"

# Email address for Cloudflare Zero Trust OTP (all services)
admin_email = "your-email@example.com"

# Edge rate limit for the Tolon site, 100 requests per 10 s per IP (default false). Needs the token permission above.
# The rate limit and the contact address are both on in the live setup.
# enable_tolon_rate_limit = true

# Tolon contact address tolon@<domain>, forwarded to admin_email by Email Routing (default false).
# Adds the apex MX and SPF records. Cloudflare creates its own DKIM record, which is not in Terraform.
# enable_tolon_contact = true
