# =============================================================================
# Homelab Docker Compose Configuration
# Copy to .env and fill in your values: cp .env.sample .env
# =============================================================================

# --- Domain & Networking ---
DOMAIN=example.com
TZ=Europe/Berlin

# --- User/Group IDs (for containers that support PUID/PGID) ---
PUID=1000
PGID=1000
# Docker socket group ID (run: getent group docker | cut -d: -f3)
DOCKER_GID=984

# --- Cloudflare Tunnel ---
# Token generated by Terraform (see terraform/outputs after 'terraform apply')
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PLUGINS=flant-statusmap-panel,ae3e-plotly-panel

# --- Portainer ---
# Generate bcrypt hash and write to ./secrets/portainer_admin_password:
#   mkdir -p secrets
#   docker run --rm httpd:2-alpine htpasswd -nbB admin 'YourPassword' | cut -d: -f2 > secrets/portainer_admin_password

# --- Stirling PDF ---
STIRLING_USERNAME=admin
STIRLING_PASSWORD=change-me

# --- Gotify ---
GOTIFY_ADMIN_USER=admin
GOTIFY_ADMIN_PASSWORD=change-me

# --- n8n ---
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=your-encryption-key-here

# --- Wazuh ---
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=change-me
WAZUH_API_USERNAME=wazuh-wui
# API password requires: 8-64 chars, uppercase, lowercase, number, symbol
WAZUH_API_PASSWORD=change-me
# JVM heap size for indexer (recommend 1g minimum)
WAZUH_INDEXER_HEAP=1g

# --- Tolon Poll ---
# Cloudflare Zero Trust team name (<team>.cloudflareaccess.com). Voters do not use Access
# (free plan: 50 seats); only the results paths do. Full guide: apps/tolon-poll/README.md
CF_ACCESS_TEAM=your-team-name
# From: terraform output -raw tolon_admin_aud (Access app guarding the results paths)
TOLON_POLL_ACCESS_AUD=your-access-app-aud
# Same value as admin_email in terraform.tfvars
ADMIN_EMAIL=your-email@example.com
# HMAC key for one-time codes and email hashes. Generate with: openssl rand -hex 32
TOLON_POLL_SESSION_SECRET=your-session-secret-here
# From: tofu output tolon_turnstile_sitekey / -raw tolon_turnstile_secret
# (set enable_tolon_turnstile = true in terraform.tfvars first). Empty secret = code requests are rejected.
TURNSTILE_SITEKEY=your-turnstile-sitekey
TURNSTILE_SECRET=your-turnstile-secret
# SMTP for one-time codes (Resend). SMTP_PASS is a send-only Resend API key. TLS required: port 465 (implicit TLS) or 587 (STARTTLS).
# Sending is off until SMTP_HOST is set and, with SMTP_USER, SMTP_PASS (the Resend API key).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
SMTP_FROM=Tolon <noreply@tolon.example.com>
# Optional: serve static files from another directory (default ./apps/tolon-poll/web)
# TOLON_POLL_WEB_DIR=./apps/tolon-poll/web

# --- Image Versions (pin for reproducibility) ---
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage:latest
HOMEPAGE_ALLOWED_HOSTS=your-domain.com
HOMEPAGE_VAR_DOMAIN=your-domain.com
HOMEPAGE_VAR_GRAFANA_PASSWORD=change-me
HOMEPAGE_VAR_PORTAINER_KEY=your-portainer-api-key
HOMEPAGE_VAR_CF_ACCOUNT_ID=your-cloudflare-account-id
HOMEPAGE_VAR_CF_TUNNEL_ID=your-cloudflare-tunnel-id
HOMEPAGE_VAR_CF_API_TOKEN=your-cloudflare-api-token
HOMEPAGE_VAR_SONARR_URL=https://your-sonarr-url
HOMEPAGE_VAR_SONARR_KEY=your-sonarr-api-key
HOMEPAGE_VAR_RADARR_URL=https://your-radarr-url
HOMEPAGE_VAR_RADARR_KEY=your-radarr-api-key
HOMEPAGE_VAR_JELLYFIN_URL=https://your-jellyfin-url
HOMEPAGE_VAR_JELLYFIN_KEY=your-jellyfin-api-key
HOMEPAGE_VAR_DELUGE_URL=https://your-deluge-url/deluge
HOMEPAGE_VAR_DELUGE_PASSWORD=your-deluge-password
HOMEPAGE_VAR_GOTIFY_KEY=your-gotify-client-token
PORTAINER_IMAGE=portainer/portainer-ce:latest
STIRLING_PDF_IMAGE=stirlingtools/stirling-pdf:latest
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
GRAFANA_IMAGE=grafana/grafana-oss:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
NODE_EXPORTER_IMAGE=prom/node-exporter:latest
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:latest
SPEEDTEST_EXPORTER_IMAGE=miguelndecarvalho/speedtest-exporter:latest
GOTIFY_IMAGE=gotify/server:latest
WAZUH_INDEXER_IMAGE=wazuh/wazuh-indexer:4.12.0
WAZUH_MANAGER_IMAGE=wazuh/wazuh-manager:4.12.0
WAZUH_DASHBOARD_IMAGE=wazuh/wazuh-dashboard:4.12.0
